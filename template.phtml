    },
    en: {
      subtitle: 'Telegram MTProto proxies — live-checked, sorted by ping',
      live: 'Live — monitoring',
      online: 'Online', total: 'Total proxies', healthy: 'Healthy',
      updated: 'Last check:',
      search_ph: 'Search server… (e.g. 149.154)',
      all: 'All', offline: 'Offline', all_types: 'All types', standard: 'Standard',
      refresh: 'Re-check',
      port: 'Port', source: 'Source', connect: 'Connect in Telegram',
      copy: 'Copy link', copied: 'Copied ✓',
      no_response: 'No response', more: 'Next 20',
      empty: 'No proxies match this filter.',
      counter: 'Showing {a} of {b}',
      just_now: 'just now', min_ago: '{n} min ago',
      pct: '%', locale: 'en-US',
      type: { 'MTProto TLS': 'TLS', 'MTProto Secure': 'Secure', 'MTProto': 'Standard' },
      status: { Online: 'Online', Offline: 'Offline' }
    },
    ar: {
      subtitle: 'بروكسيات MTProto لتيليجرام — فحص مباشر مرتبة حسب البينق',
      live: 'مباشر — قيد المراقبة',
      online: 'متصل', total: 'إجمالي البروكسيات', healthy: 'سليمة',
      updated: 'آخر فحص:',
      search_ph: 'ابحث في الخادم… (مثال: 149.154)',
      all: 'الكل', offline: 'غير متصل', all_types: 'كل الأنواع', standard: 'عادي',
      refresh: 'إعادة الفحص',
      port: 'المنفذ', source: 'المصدر', connect: 'اتصال في تيليجرام',
      copy: 'نسخ الرابط', copied: 'تم النسخ ✓',
      no_response: 'بلا استجابة', more: 'التالي ٢٠',
      empty: 'لا توجد نتائج مطابقة لهذا الفلتر.',
      counter: 'عرض {a} من {b}',
      just_now: 'الآن', min_ago: 'منذ {n} دقيقة',
      pct: '٪', locale: 'ar-EG',
      type: { 'MTProto TLS': 'TLS', 'MTProto Secure': 'Secure', 'MTProto': 'عادي' },
      status: { Online: 'متصل', Offline: 'غير متصل' }
    }
  };

  var lang = 'fa';
  try { lang = localStorage.getItem('mtprotolive-lang') || 'fa'; } catch (e) {}
  if (!I18N[lang]) lang = 'fa';
  var t = I18N[lang];

  var DIGITS = {
    fa: '۰۱۲۳۴۵۶۷۸۹',
    ar: '٠١٢٣٤٥٦٧٨٩',
    en: '0123456789'
  };
  function formatNum(n) {
    var d = DIGITS[lang] || DIGITS.en;
    return String(n).replace(/\d/g, function (ch) { return d[+ch]; });
  }

  function applyLang() {
    t = I18N[lang];
    document.documentElement.setAttribute('lang', lang);
    document.documentElement.setAttribute('dir', lang === 'en' ? 'ltr' : 'rtl');
    document.querySelectorAll('[data-i18n]').forEach(function (el) {
      var k = el.getAttribute('data-i18n');
      if (t[k] !== undefined) el.textContent = t[k];
    });
    document.querySelectorAll('[data-i18n-ph]').forEach(function (el) {
      var k = el.getAttribute('data-i18n-ph');
      if (t[k] !== undefined) el.setAttribute('placeholder', t[k]);
    });
    document.querySelectorAll('[data-num]').forEach(function (el) {
      var n = parseInt(el.getAttribute('data-num'), 10);
      el.textContent = formatNum(isNaN(n) ? 0 : n) + (el.hasAttribute('data-pct') ? t.pct : '');
    });
    document.querySelectorAll('.type-badge').forEach(function (el) {
      el.textContent = (t.type && t.type[el.getAttribute('data-type')]) || el.getAttribute('data-type');
    });
    document.querySelectorAll('.status-txt').forEach(function (el) {
      el.textContent = (t.status && t.status[el.getAttribute('data-status')]) || el.getAttribute('data-status');
    });
    document.querySelectorAll('#langSwitch button').forEach(function (b) {
      b.classList.toggle('active', b.getAttribute('data-lang') === lang);
    });
    try { localStorage.setItem('mtprotolive-lang', lang); } catch (e) {}
    tick();
    render();
  }

  document.getElementById('langSwitch').addEventListener('click', function (e) {
    var b = e.target.closest('button[data-lang]');
    if (!b) return;
    lang = b.getAttribute('data-lang');
    applyLang();
  });

  /* ---------- Dark / light toggle (default: dark) ---------- */
  document.getElementById('themeBtn').addEventListener('click', function () {
    var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('mtprotolive-theme', next); } catch (e) {}
  });

  function fa(n) { return formatNum(n); }

  function visible() {
    var q = search.value.trim().toLowerCase();
    return cards.filter(function (c) {
      if (statusFilter !== 'all' && c.dataset.status !== statusFilter) return false;
      if (typeFilter !== 'all' && c.dataset.type !== typeFilter) return false;
      if (q && c.dataset.server.indexOf(q) === -1) return false;
      return true;
    });
  }

  function render() {
    var list = visible();
    cards.forEach(function (c) { c.style.display = 'none'; });
    list.slice(0, shown).forEach(function (c) { c.style.display = ''; });
    empty.style.display = list.length ? 'none' : 'block';
    counter.textContent = list.length
      ? t.counter.replace('{a}', fa(Math.min(shown, list.length))).replace('{b}', fa(list.length))
      : '';
    moreBtn.style.display = list.length > shown ? '' : 'none';
  }

  moreBtn.addEventListener('click', function () { shown += PAGE; render(); });

  function bindChips(id, setter) {
    document.getElementById(id).addEventListener('click', function (e) {
      var b = e.target.closest('.chip');
      if (!b) return;
      this.querySelectorAll('.chip').forEach(function (x) { x.classList.remove('active'); });
      b.classList.add('active');
      setter(b.dataset.status || b.dataset.type);
      shown = PAGE;
      render();
    });
  }
  bindChips('statusChips', function (v) { statusFilter = v; });
  bindChips('typeChips', function (v) { typeFilter = v; });
  search.addEventListener('input', function () { shown = PAGE; render(); });

  grid.addEventListener('click', function (e) {
    var b = e.target.closest('[data-copy]');
    if (!b) return;
    var link = b.dataset.copy;
    function done() { b.textContent = t.copied; setTimeout(function () { b.textContent = t.copy; }, 1500); }
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(link).then(done, function () { fallback(); });
    } else { fallback(); }
    function fallback() {
      var ta = document.createElement('textarea');
      ta.value = link; document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); done(); } catch (err) {}
      document.body.removeChild(ta);
    }
  });

  // Last-scan relative time (Tehran)
  var tsEl = document.getElementById('updated');
  var ts = parseInt(tsEl.dataset.ts || '0', 10);
  function tick() {
    if (!ts) { tsEl.textContent = '—'; return; }
    var mins = Math.max(0, Math.round((Date.now() / 1000 - ts) / 60));
    var clock = new Date(ts * 1000).toLocaleTimeString(t.locale, { timeZone: 'Asia/Tehran', hour: '2-digit', minute: '2-digit' });
    var ago = mins < 1 ? t.just_now : t.min_ago.replace('{n}', formatNum(mins));
    tsEl.textContent = clock + ' (' + ago + ')';
  }
  tick();
  setInterval(tick, 60000);

  applyLang();
})();
</script>
</body>
</html>
